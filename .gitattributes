# Normalize line endings: store as LF in the repo, check out native on each OS.
* text=auto

# Keep these as LF even on Windows checkouts.
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Treat as binary — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
