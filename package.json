{
  "name": "foropencode-docs",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "gen": "node scripts/gen-content-manifest.mjs",
    "predev": "node scripts/gen-content-manifest.mjs",
    "dev": "next dev --webpack --port 3020 --hostname 127.0.0.1",
    "prebuild": "node scripts/gen-content-manifest.mjs && node scripts/build-search-index.mjs",
    "build": "next build --webpack",
    "start": "next start --port 3020 --hostname 0.0.0.0",
    "pretypecheck": "node scripts/gen-content-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.2.12",
    "@types/mdx": "^2.0.14",
    "gray-matter": "^4.0.3",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "github-slugger": "^2.0.0",
    "playwright": "^1.62.0",
    "typescript": "^5.9.3"
  }
}
